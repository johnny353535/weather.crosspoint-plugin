{
  "title": "Weather",
  "description": "Local weather on your sleep screen. Set your location in plugin settings.",
  "config": {
    "file": "config.json"
  },
  "events": {
    "sleep.enter": {
      "download": {
        "url": "{cfg.worker_url}?latitude={cfg.latitude}&longitude={cfg.longitude}&location={cfg.location}&unit={cfg.unit}",
        "dest": "/sleep.bmp"
      }
    }
  }
}
